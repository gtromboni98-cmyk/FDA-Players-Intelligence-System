# Wyscout API Credentials
WYSCOUT_CLIENT_ID=your_client_id_here
WYSCOUT_CLIENT_SECRET=your_client_secret_here

# API Configuration
API_BASE_URL=https://your_api_base_url_here
API_TIMEOUT=your_api_timeout_here

# Competition IDs - Italian football competitions
COMPETITION_SERIE_A=your_serie_a_id_here
COMPETITION_SERIE_B=your_serie_b_id_here
COMPETITION_SERIE_C=your_serie_c_id_here
COMPETITION_PRIMAVERA_1=your_primavera_id_here

# Active Competitions (comma-separated IDs, excludes Primavera by default)
ACTIVE_COMPETITION_IDS=your_active_competition_ids_here

# Data Directories
CACHE_DIR=your_cache_directory_here
RAW_DATA_DIR=your_raw_data_directory_here
PROCESSED_DATA_DIR=your_processed_data_directory_here

# Application Settings
ENVIRONMENT=your_environment_here
LOG_LEVEL=your_log_level_here

